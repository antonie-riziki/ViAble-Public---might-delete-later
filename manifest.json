{
  "manifest_version": 3,
  "name": "ViAble",
  "version": "0.1.0",
  "description": "An AI-powered multilingual web accessibility and interaction assistant.",
  "permissions": ["activeTab", "tabs", "sidePanel", "storage", "scripting"],
  "host_permissions": ["<all_urls>", "http://localhost:8787/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/page-context.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Open ViAble",
    "default_icon": {
      "16": "brand/icon16.png",
      "32": "brand/icon32.png",
      "48": "brand/icon48.png",
      "128": "brand/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "brand/icon16.png",
    "32": "brand/icon32.png",
    "48": "brand/icon48.png",
    "128": "brand/icon128.png"
  }
}
