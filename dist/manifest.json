{
  "manifest_version": 3,
  "name": "VIAble — Accessibility assistant",
  "version": "0.1.0",
  "description": "An AI-powered multilingual web accessibility and interaction assistant.",
  "permissions": ["activeTab", "sidePanel", "storage", "scripting"],
  "action": {
    "default_title": "Open VIAble"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "brand/icon16.png",
    "32": "brand/icon32.png",
    "48": "brand/icon48.png",
    "128": "brand/icon128.png"
  }
}
